# Copy to .env, then run commands as: uv run --env-file .env <cmd>   (from the repo root)

# Python 3.14 + uv on macOS ignores the hidden .pth of the editable install → expose src/.
PYTHONPATH=src

# macOS 27 / clang >= 21 only: PyTensor's "-ld64" linker flag breaks C compilation.
# Remove this line on Linux or older macOS.
PYTENSOR_FLAGS=cxx=scripts/clang++-no-ld64
